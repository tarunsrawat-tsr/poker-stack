# Absolute origin of the deployed app. Used only for social share previews
# (og:image / twitter:image), which crawlers require to be absolute URLs.
# Leave empty for local development; images then resolve relatively.
#
# After your first Vercel deploy, set this in:
#   Project -> Settings -> Environment Variables -> Production
#   VITE_SITE_URL=https://your-project.vercel.app
VITE_SITE_URL=
